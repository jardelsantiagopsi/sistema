rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Pacientes — somente o psicólogo autenticado
    match /pacientes/{docId} {
      allow read, write: if request.auth != null;
    }

    // Escalas personalizadas — leitura pública (paciente precisa carregar), escrita autenticada
    match /escalas/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Respostas — qualquer um pode criar (paciente envia sem login), leitura/edição autenticada
    match /respostas/{docId} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }

    // Envios — somente o psicólogo autenticado
    match /envios/{docId} {
      allow read, write: if request.auth != null;
    }
  }
}
